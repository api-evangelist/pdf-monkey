{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDF Monkey Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pdfmonkey.io/api/v1/current_user"
          },
          "docs": "Retrieve the current authenticated user account information. Useful for verifying API credentials."
        }
      ]
    }
  ],
  "bundled": true
}
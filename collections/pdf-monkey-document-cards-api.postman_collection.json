          "name": "List document cards",
          "request": {
            "name": "List document cards",
            "description": {
              "content": "List documents as lightweight document cards (no payload), with pagination and filtering. The endpoint returns up to 24 items per page.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "document_cards"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page[number]",
                  "value": "1",
                  "description": "Number of the page to show (default 1)."
                },
                {
                  "disabled": false,
                  "key": "q[document_template_id]",
                  "value": "<string>",
                  "description": "Filter on one or more template IDs."
                },
                {
                  "disabled": false,
                  "key": "q[status]",
                  "value": "<string>",
                  "description": "Filter on document status."
                },
                {
                  "disabled": false,
                  "key": "q[workspace_id]",
                  "value": "<string>",
                  "description": "ID of a workspace to filter on."
                },
                {
                  "disabled": false,
                  "key": "q[updated_since]",
                  "value": "<dateTime>",
                  "description": "Filter documents updated after a given point in time."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],

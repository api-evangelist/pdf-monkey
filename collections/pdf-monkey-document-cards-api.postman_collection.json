          "name": "Fetch a document card",
          "request": {
            "name": "Fetch a document card",
            "description": {
              "content": "Retrieve a lightweight document card for a document. This is the recommended way to poll generation status and obtain the download URL, since it omits the heavy payload attribute.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "document_cards",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) The UUID of the document."
                }
              ]
            },
